  {
    "rule_id": "INT_PCR_MFR_DECLARATION",
    "rule_reference": "Rule 6(1)(a) & Rule 10",
    "rule_family": "Manufacturer / Packer / Importer",
    "requirement": "Every retail package must declare the registered name and complete address of the manufacturer, packer, or importer.",
    "description": "The package must conspicuously display the complete registered postal address of the manufacturer or packer. If imported, the name and complete address of the importer must be declared. Brand owners appearing as marketers are 'deemed manufacturers' and held responsible for violations. If multiple names appear, prosecution is launched against the first name.",
    "applies_to": [
      "retail_package"
    ],
    "conditions": [
      "not_exempt_under_rule_3",
      "not_exempt_under_rule_26"
    ],
    "exceptions": [
      "small_package_capacity_limit_10_cc"
    ],
    "validation_logic": "assert_conspicuously_declared(['name', 'address']) and assert_complete_address_format()",
    "threshold": 10.0,
    "unit": "cubic_centimeter",
    "effective_from": "2011-04-01",
