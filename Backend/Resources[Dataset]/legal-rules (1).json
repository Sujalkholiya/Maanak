  {
    "rule_id": "INT_PCR_MFG_DATE_DECLARATION",
    "rule_reference": "Rule 6(1)(d)",
    "rule_family": "Date of Manufacture",
    "requirement": "Conspicuously declare strictly the Month and Year in which the commodity was manufactured.",
    "description": "Requires Month and Year of Manufacture. The words 'or pre-packed or imported' are omitted w.e.f 1-10-2022. Rubber-stamping without overwriting is permitted. Exempts bidi, agarbatti, domestic LPG, and warranty spare parts from date of manufacture declarations.",
    "applies_to": [
      "retail_package"
    ],
    "conditions": [
      "not_exempt_under_rule_3",
      "not_exempt_under_rule_26",
      "is_warranty_spare == false"
    ],
    "exceptions": [
      "bidi_agarbatti_packages",
      "domestic_lpg_cylinders",
      "seeds_act_certified",
      "cosmetics_act",
      "food_articles_act"
    ],
    "validation_logic": "assert_conspicuously_declared(['manufacturing_date']) and assert_date_pattern(r'\\b(?:Mfg\\.?\\s*Date|Manufactured|Mfg)\\s*:\\s*(?:\\d{2}[/-]\\d{4}|[a-zA-Z]{3,9}\\s*\\d{4})\\b')",
