  {
    "rule_id": "INT_PCR_NET_QUANTITY_DECLARATION",
    "rule_reference": "Rule 6(1)(c) & Rules 11-13",
    "rule_family": "Net Quantity",
    "requirement": "Conspicuously declare the net quantity of the commodity contained in the package in standard metric units.",
    "description": "Requires net weight, volume, or length/number to be declared. Excludes weight of wrappers/packaging. Strictly prohibits any qualifying expressions that tend to create an exaggerated or misleading impression (such as 'minimum', 'not less than', 'average', 'about', 'approximately'). Items sold by number must declare as 'number' or 'unit' or 'piece' or 'set' etc.",
    "applies_to": [
      "retail_package"
    ],
    "conditions": [
      "not_exempt_under_rule_3",
      "not_exempt_under_rule_26"
    ],
    "exceptions": [
      "small_package_limit_10g_ml"
    ],
    "validation_logic": "assert_conspicuously_declared(['net_quantity']) and assert_no_qualifying_words() and assert_standard_metric_units()",
    "threshold": 10.0,
    "unit": "g_or_ml",
    "effective_from": "2011-04-01",
    "effective_until": null,
