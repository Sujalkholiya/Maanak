    "rule_id": "INT_PCR_UNIT_SALE_PRICE",
    "rule_reference": "Rule 6(11)",
    "rule_family": "Unit Sale Price",
    "requirement": "Conspicuously declare the Unit Sale Price (USP) in Rupees rounded off to the nearest two decimal places.",
    "description": "USP must be declared per g (if net weight < 1 kg), per kg (if net weight >= 1 kg), per ml (if net volume < 1 L), per L (if net volume >= 1 L), per cm (if net length < 1 m), per m (if net length >= 1 m), or per number. Exempted if MRP is mathematically equal to USP, or on combination, group, or multi-piece packs.",
    "applies_to": [
      "retail_package"
    ],
    "conditions": [
      "not_exempt_under_rule_3",
      "not_exempt_under_rule_26",
      "is_combination_pack == false",
      "is_group_pack == false",
      "is_multipiece_pack == false",
      "net_quantity_metric != 1.0"
    ],
    "exceptions": [
      "usp_equals_mrp",
      "liquor_state_excise_override_usp"
    ],
    "validation_logic": "assert_conspicuously_declared(['unit_sale_price']) and assert_two_decimal_rounding() and assert_mathematical_usp_matches_mrp_by_quantity()",
