    "rule_id": "INT_PCR_BONDED_WAREHOUSE_DECLARATIONS",
    "rule_reference": "Rule 4 Explanation-2",
    "rule_family": "Import declarations",
    "requirement": "AEO Tier-2 and Tier-3 certified importers are allowed to make mandatory declarations at customs-bonded warehouses prior to customs clearance.",
    "description": "Provides relaxation allowing Authorised Economic Operators (AEO) Tier-2 and Tier-3 certified importers to complete LMPC retail declarations at bonded warehouses. All declarations must be physically completed before leaving the bonded warehouse.",
